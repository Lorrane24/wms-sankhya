# Modelo do .env: copie para um arquivo chamado .env e preencha os valores.
# NUNCA coloque senhas neste arquivo (ele vai para o GitHub).

# Qual base usar agora: TESTE ou PRODUCAO
SANKHYA_BASE=TESTE

# Endereço do Gateway de cada base
SANKHYA_PROD_URL=https://api.sankhya.com.br
SANKHYA_TESTE_URL=https://api.sandbox.sankhya.com.br

# Base de PRODUÇÃO
SANKHYA_PROD_CLIENT_ID=
SANKHYA_PROD_CLIENT_SECRET=
SANKHYA_PROD_X_TOKEN=

# Base de TESTE
SANKHYA_TESTE_CLIENT_ID=
SANKHYA_TESTE_CLIENT_SECRET=
SANKHYA_TESTE_X_TOKEN=

# SIM = dados de mentira (Sankhya fora do ar). Vazio = Sankhya de verdade.
USAR_DADOS_FALSOS=